diff --git a/src/cuda/helpers.h b/src/cuda/helpers.h
index 7b99149..c1bf32b 100644
--- a/src/cuda/helpers.h
+++ b/src/cuda/helpers.h
@@ -10,6 +10,10 @@
 #include <hip/hip_bf16.h>
 #include <hip/hip_fp8.h>
 #define __nv_bfloat16 __hip_bfloat16
+// HIP has no __syncwarp; a wavefront-wide barrier is the closest equivalent.
+#ifndef __syncwarp
+#define __syncwarp(mask) __builtin_amdgcn_wave_barrier()
+#endif
 #else
 #include <cuda_fp16.h>
 #include <cuda_bf16.h>
diff --git a/src/cuda/primitives.cu b/src/cuda/primitives.cu
index bd52800..be0174d 100644
--- a/src/cuda/primitives.cu
+++ b/src/cuda/primitives.cu
@@ -11,15 +11,33 @@
 #define cublasSgemm hipblasSgemm
 #define CUBLAS_OP_T HIPBLAS_OP_T
 #define CUBLAS_OP_N HIPBLAS_OP_N
+#if HIP_VERSION_MAJOR >= 6
 #define cublasComputeType_t hipblasComputeType_t
 #define CUBLAS_COMPUTE_16F HIPBLAS_COMPUTE_16F
 #define CUBLAS_COMPUTE_32F HIPBLAS_COMPUTE_32F
 #define CUBLAS_COMPUTE_32I HIPBLAS_COMPUTE_32I
+#else
+// ROCm 5.7: hipblasGemmEx takes hipblasDatatype_t for the compute type and
+// hipblasComputeType_t does not exist.
+#define cublasComputeType_t hipblasDatatype_t
+#define CUBLAS_COMPUTE_16F HIPBLAS_R_16F
+#define CUBLAS_COMPUTE_32F HIPBLAS_R_32F
+#define CUBLAS_COMPUTE_32I HIPBLAS_R_32I
+#endif
+#if HIP_VERSION_MAJOR >= 6
 #define CUDA_R_16F HIP_R_16F
 #define CUDA_R_16BF HIP_R_16BF
 #define CUDA_R_32F HIP_R_32F
 #define CUDA_R_8I HIP_R_8I
 #define CUDA_R_32I HIP_R_32I
+#else
+// ROCm 5.7 hipblas expects hipblasDatatype_t, not hipDataType.
+#define CUDA_R_16F HIPBLAS_R_16F
+#define CUDA_R_16BF HIPBLAS_R_16B
+#define CUDA_R_32F HIPBLAS_R_32F
+#define CUDA_R_8I HIPBLAS_R_8I
+#define CUDA_R_32I HIPBLAS_R_32I
+#endif
 #define CUBLAS_GEMM_DEFAULT HIPBLAS_GEMM_DEFAULT
 #define cublasSgemmStridedBatched hipblasSgemmStridedBatched
 #define cublasGemmEx hipblasGemmEx
diff --git a/src/ops/quantize_cpu.cc b/src/ops/quantize_cpu.cc
index f81f39e..d90b93a 100644
--- a/src/ops/quantize_cpu.cc
+++ b/src/ops/quantize_cpu.cc
@@ -60,10 +60,14 @@ namespace ctranslate2 {
 
       scale = StorageView(scale_value);
 
-      if (_round_before_cast)
-        quantize_s16_kernel(input_data, scale_value, output_data, size, std::nearbyintf);
-      else
+      if (_round_before_cast) {
+        // HIP defines nearbyintf as a macro; wrap in a lambda so the template
+        // argument deduces to a concrete callable type.
+        quantize_s16_kernel(input_data, scale_value, output_data, size,
+                            [](float v) { return std::nearbyint(v); });
+      } else {
         quantize_s16_kernel(input_data, scale_value, output_data, size, cpu::identity());
+      }
     }
 
   }
